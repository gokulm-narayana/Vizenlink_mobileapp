<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Needed by connectivity_plus to report Wi-Fi vs. mobile-data
         connection type (mobile-app-cellular-data-usage-awareness). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Needed by the gal package to save snapshots/recordings to the
         gallery on API 28 and below; MediaStore handles it without this
         permission on API 29+. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <!-- Needed by the wifi_scan package to list nearby networks on
         wifi_config_screen (Android only — iOS has no public API for this).
         ACCESS_FINE_LOCATION is what the package's own canStartScan/
         canGetScannedResults checks request; Android ties Wi-Fi scan
         results to location permission, no way around it. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Needed for reliable UDP multicast reception during WS-Discovery
         camera scanning (packages/camera_api's WsDiscoveryClient.
         scanMulticast) — without it, the Wi-Fi radio's power-saving filter
         can silently drop incoming multicast packets. Declaring this alone
         doesn't acquire the lock at runtime (that needs WifiManager.
         MulticastLock via a platform channel, which this pure-Dart package
         doesn't do yet) but is required before anything can. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- Required by flutter_webrtc's native Android audio device module, even for a
         receive-only audio transceiver (live view has no local mic capture on its own, but
         the ADM initializes audio routing regardless) — per flutter_webrtc's own setup docs.
         Missing these causes a native crash immediately after WebRTC connects, not a
         catchable Dart exception. RECORD_AUDIO is also what two-way talk's getUserMedia
         (LiveViewController.startTalk) captures the mic through. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <!-- Bluetooth audio-routing permissions the ADM also touches — split by API level per
         Android 12's (API 31) BLUETOOTH_CONNECT runtime-permission change. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- alerts_api's always-on background camera-alert listener
         (CameraAlertsHub, packages/alerts_api) runs as a foreground service
         via flutter_foreground_task — that plugin's own manifest already
         merges in FOREGROUND_SERVICE/WAKE_LOCK/RECEIVE_BOOT_COMPLETED/
         POST_NOTIFICATIONS, but not the specific service-type permission
         Android 14 (API 34) requires for the dataSync foreground-service
         type this app requests (ForegroundServiceTypes.dataSync in
         CameraAlertsHub.ensureRunning's startService call). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <application
        android:label="VizenLink"
        android:name="${applicationName}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Required by flutter_foreground_task (alerts_api's CameraAlertsHub) — the plugin
             does NOT register this service via its own plugin manifest; every consuming app
             must declare it directly (per the plugin's own example app manifest). Missing this
             is why CameraAlertsHub.ensureRunning's startService call silently failed with
             "Unable to start service ... not found" — the service class was never declared
             anywhere in this app's manifest. Warning: do not change the service name.
             foregroundServiceType must match ForegroundServiceTypes.dataSync passed to
             startService() in camera_alerts_hub.dart. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
